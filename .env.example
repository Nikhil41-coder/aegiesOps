# =============================================================================
# AegisOps & Copilot Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# NEVER commit your actual '.env' file containing real secrets to source control.
# =============================================================================

# --- Core AegisOps Operational Settings ---
AEGISOPS_MODE=simulate
AEGISOPS_DATABASE_URL=sqlite:///aegisops.db
AEGISOPS_OPERATOR_TOKEN=test-operator-token
AEGISOPS_APPROVER=local-operator
AEGISOPS_KILL_FILE=/etc/automation/KILL

# --- AegisOps Copilot Settings ---
# Path to the isolated SQLite knowledge base (read-only for Copilot queries)
AEGISOPS_COPILOT_DB_PATH=data/copilot_knowledge.db

# Path to original source CSV directory (read-only)
AEGISOPS_SOURCE_CSV_DIR=data/source_csv

# Path to persistent ChromaDB vector index directory
AEGISOPS_CHROMA_DIR=data/chroma_db

# Embedding provider:
# - 'default': Persistent ONNX all-MiniLM-L6-v2 embeddings (no API key required)
# - 'fast': Deterministic local hashing embeddings for instant test execution
AEGISOPS_EMBEDDING_PROVIDER=default

# --- Gemini LLM Settings (Optional) ---
# If GEMINI_API_KEY is omitted or blank, Copilot automatically uses the
# deterministic grounded synthesizer with 100% evidence attribution.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

